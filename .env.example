# ---- Runtime ----
NODE_ENV=development

# ---- API ----
PORT=5000
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Railway injects DATABASE_URL in production; prefer it when present.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=canvas

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage ----
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Frontend (Vite: must be VITE_ prefixed) ----
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000/collab
VITE_GOOGLE_CLIENT_ID=
